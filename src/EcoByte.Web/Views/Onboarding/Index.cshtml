@model OnboardingViewModel
@{
    ViewData["Title"] = "Seu perfil";
}

<div class="auth-container">
    <div class="form-card">
        <h1>Complete seu cadastro</h1>
        <p style="color:var(--texto-secundario);margin-bottom:1.5rem;">Escolha como voce deseja participar do EcoByte.</p>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alerta alerta-erro">
                @Html.ValidationSummary()
            </div>
        }

        <form asp-controller="Onboarding" asp-action="Index" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" />
                <span asp-validation-for="Nome"></span>
            </div>

            <div class="form-group">
                <label asp-for="Perfil"></label>
                <select asp-for="Perfil" class="input-select">
                    <option value="">Selecione o perfil</option>
                    <option value="Consumidor">Consumidor</option>
                    <option value="Parceiro">Parceiro / Estabelecimento</option>
                    <option value="Ong">ONG</option>
                </select>
                <span asp-validation-for="Perfil"></span>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;">Continuar</button>
        </form>

        <p style="text-align:center;margin-top:1rem;">
            <a asp-controller="Home" asp-action="Index">Voltar ao inicio</a>
        </p>
    </div>
</div>