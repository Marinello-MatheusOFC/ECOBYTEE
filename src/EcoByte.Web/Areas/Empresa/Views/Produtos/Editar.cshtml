@model ProdutoFormularioViewModel
@{
    ViewData["Title"] = "Editar Produto";
}

<h1>Editar Produto</h1>

<div class="form-card">
    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alerta alerta-erro">@Html.ValidationSummary()</div>
    }

    <form asp-controller="Produtos" asp-action="Editar" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome"></span>
        </div>
        <div class="form-group">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao"></textarea>
            <span asp-validation-for="Descricao"></span>
        </div>
        <div class="form-group">
            <label asp-for="PrecoOriginal"></label>
            <input asp-for="PrecoOriginal" type="number" step="0.01" />
            <span asp-validation-for="PrecoOriginal"></span>
        </div>
        <div class="form-group">
            <label asp-for="PrecoPromocional"></label>
            <input asp-for="PrecoPromocional" type="number" step="0.01" />
            <span asp-validation-for="PrecoPromocional"></span>
        </div>
        <div class="form-group">
            <label asp-for="QuantidadeDisponivel"></label>
            <input asp-for="QuantidadeDisponivel" type="number" />
            <span asp-validation-for="QuantidadeDisponivel"></span>
        </div>
        <div class="form-group">
            <label asp-for="DataLimite"></label>
            <input asp-for="DataLimite" type="date" />
            <span asp-validation-for="DataLimite"></span>
        </div>
        <div class="form-group">
            <label asp-for="Categoria"></label>
            <select asp-for="Categoria" asp-items="Html.GetEnumSelectList<CategoriaProduto>()"></select>
        </div>
        <div class="form-group">
            <label asp-for="ImagemUrl"></label>
            <input asp-for="ImagemUrl" />
        </div>
        <div class="form-group">
            <label><input asp-for="EhVegano" /> Vegano</label>
            <label><input asp-for="EhSemGluten" /> Sem Gluten</label>
            <label><input asp-for="EhSemLactose" /> Sem Lactose</label>
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>