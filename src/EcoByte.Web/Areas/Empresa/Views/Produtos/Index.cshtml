@model List<Produto>
@{
    ViewData["Title"] = "Meus Produtos";
    int pagina = ViewBag.Pagina ?? 1;
}

<h1>Meus Produtos</h1>
<a asp-controller="Produtos" asp-action="Criar" class="btn btn-primary" style="margin-bottom:1rem;">Novo Produto</a>

@if (TempData["Sucesso"] != null)
{
    <div class="alerta alerta-sucesso">@TempData["Sucesso"]</div>
}

<div class="tabela-container">
    <table class="tabela">
        <thead>
            <tr><th>Nome</th><th>Categoria</th><th>Preco</th><th>Qtd</th><th>Status</th><th>Acoes</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Nome</td>
                    <td>@p.Categoria</td>
                    <td>R$ @((p.PrecoPromocionalCentavos / 100m).ToString("F2"))</td>
                    <td>@p.QuantidadeDisponivel</td>
                    <td>@p.Status</td>
                    <td>
                        <a asp-controller="Produtos" asp-action="Editar" asp-route-id="@p.Id" class="btn btn-warning" style="padding:0.2rem 0.5rem;font-size:0.8rem;">Editar</a>
                        <form asp-controller="Produtos" asp-action="Excluir" asp-route-id="@p.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger" style="padding:0.2rem 0.5rem;font-size:0.8rem;">Excluir</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>