@model ProdutoFormularioViewModel
@{
    ViewData["Title"] = "Editar Produto";
}

<h1>Editar Produto</h1>

<div class="form-card">
    <form asp-controller="Produtos" asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div class="form-group">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome"></span>
        </div>
        <div class="form-group">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="PrecoOriginal"></label>
            <input asp-for="PrecoOriginal" type="number" step="0.01" />
        </div>
        <div class="form-group">
            <label asp-for="PrecoPromocional"></label>
            <input asp-for="PrecoPromocional" type="number" step="0.01" />
        </div>
        <div class="form-group">
            <label asp-for="QuantidadeDisponivel"></label>
            <input asp-for="QuantidadeDisponivel" type="number" />
        </div>
        <div class="form-group">
            <label asp-for="DataLimite"></label>
            <input asp-for="DataLimite" type="date" />
        </div>
        <div class="form-group">
            <label asp-for="Categoria"></label>
            <select asp-for="Categoria" asp-items="Html.GetEnumSelectList<CategoriaProduto>()"></select>
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
