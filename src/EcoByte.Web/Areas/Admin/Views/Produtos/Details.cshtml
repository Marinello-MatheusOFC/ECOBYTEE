@model ProdutoDetalhesViewModel
@{
    ViewData["Title"] = "Detalhes do Produto";
}

<h1>@Model.Nome</h1>

<div class="form-card">
    <div class="form-group"><label>Categoria</label><p>@Model.CategoriaDescricao</p></div>
    <div class="form-group"><label>Preco Original</label><p>R$ @Model.PrecoOriginal.ToString("F2")</p></div>
    <div class="form-group"><label>Preco Promocional</label><p>R$ @Model.PrecoPromocional.ToString("F2")</p></div>
    <div class="form-group"><label>Desconto</label><p>@Model.PercentualDesconto%</p></div>
    <div class="form-group"><label>Quantidade</label><p>@Model.QuantidadeDisponivel</p></div>
    <div class="form-group"><label>Data Limite</label><p>@Model.DataLimite.ToString("dd/MM/yyyy")</p></div>
    <div class="form-group"><label>Descricao</label><p>@Model.Descricao</p></div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>
