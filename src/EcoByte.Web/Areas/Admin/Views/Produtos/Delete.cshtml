@model ProdutoDetalhesViewModel
@{
    ViewData["Title"] = "Excluir Produto";
}

<h1>Excluir Produto</h1>

<div class="alerta alerta-erro">
    <p>Tem certeza que deseja excluir este produto?</p>
</div>

<div class="form-card">
    <div class="form-group">
        <label>Nome</label>
        <p>@Model.Nome</p>
    </div>
    <div class="form-group">
        <label>Preco</label>
        <p>R$ @Model.PrecoPromocional.ToString("F2")</p>
    </div>

    <form asp-controller="Produtos" asp-action="Delete" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Confirmar Exclusao</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
