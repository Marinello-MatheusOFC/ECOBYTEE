@model List<SolicitacaoViewModel>
@{
    ViewData["Title"] = "Solicitacoes";
}

<h1>Solicitacoes</h1>

<div class="tabela-container">
    <table class="tabela">
        <thead>
            <tr><th>Produto</th><th>Qtd</th><th>Status</th><th>Data</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@(s.ProdutoNome ?? "N/D")</td>
                    <td>@s.Quantidade</td>
                    <td><span class="badge badge-info">@s.StatusDescricao</span></td>
                    <td>@s.CriadoEm.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
